--- !u!114 &44001840
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 44001838}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d4378a068617c9749b5e05bd7d790d50, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  korean: "<b><size=130><color=#EEEE00>RBT2024</color></size></b>\n\n\n\n\uAE30\uD68D/\uB9AC\uB4DC
    \uAC1C\uBC1C/\uC5EC\uB7EC \uAC00\uC9C0: \uC7A5\uD604\uC6D0\n\n\uB514\uC790\uC778:
    \uD53C\uC740\uC11C\n\n\uAC1C\uBC1C: \uD669\uC0C1\uD604, \uC88C\uD638\uBE48\n\n\n\n\n\n\n\n\n*\uBA40\uB9AC\uC11C
    \uAC00\uBA74\uC744 \uC4F4 \uB204\uAD70\uAC00\uAC00 \uAC78\uC5B4\uC628\uB2E4*\n\n\uC5D8\uB9AC\uC544\uC2A4:
    \"\uB204\uAD6C\uC57C?\"\n\n???: \"\uD5E4\uC5B4\uC9C0\uAE30 \uC55E\uC11C \uD55C
    \uAC00\uC9C0 \uB9D0\uD574\uC918\uC57C \uD560 \uAC83 \uAC19\uC544\uC11C \uC9C1\uC811
    \uCC3E\uC544\uC654\uB2E4.\"\n\n\uC5D8\uB9AC\uC544\uC2A4: \"\uADF8 \uBAA9\uC18C\uB9AC\uB294...\"\n\n\uC870\uB825\uC790:
    \"\uADF8\uB798, \uB098\uB2E4.\"\n\n*\uC870\uB825\uC790\uAC00 \uAC00\uBA74\uC744
    \uBC97\uB294\uB2E4*\n\n\uC5D8\uB9AC\uC544\uC2A4: \"\uB108... \uB85C\uBD07\uC774\uC5C8\uC5B4?\"\n\n\uC870\uB825\uC790:
    \"\uADF8\uB798.\"\n\n\uC5D8\uB9AC\uC544\uC2A4: \"\uB85C\uBD07\uC774\uBA74\uC740
    \uD68C\uC0AC\uB294 \uB124 \uBD80\uBAA8\uC640 \uB9C8\uCC2C\uAC00\uC9C0\uC77C \uD150\uB370...
    \uC774\uB7F0 \uC9D3\uC744 \uBC8C\uC778 \uC774\uC720\uAC00 \uBB50\uC57C?\"\n\n\uC870\uB825\uC790:
    \"\uC9C0\uAE08\uC758 \uD68C\uC0AC\uC758 \uBC29\uC2DD\uC740 \uC798\uBABB\uB410\uB2E4.
    \uB85C\uBD07\uC744 \uC774\uC6A9\uD55C \uB05D\uC5C6\uB294 \uC5B5\uC555\uC740 \uACB0\uAD6D
    \uC778\uAC04\uACFC \uB85C\uBD07 \uB458 \uB2E4 \uC790\uBA78\uD558\uAC8C \uB9CC\uB4E4
    \uBFD0\uC774\uB2E4.\"\n\n\uC870\uB825\uC790: \"\uB098\uB294 \uC778\uAC04\uACFC
    \uB85C\uBD07\uC774 \uACF5\uC874\uD558\uB294 \uBBF8\uB798\uB97C \uC6D0\uD55C\uB2E4.
    \uADF8\uAC8C \uC124\uB839 \uD68C\uC0AC\uB97C \uBB34\uB108\uB728\uB9AC\uB294 \uAC70\uB77C\uACE0
    \uD574\uB3C4. \uADF8\uAC8C \uB0B4\uAC00 \uB808\uC9C0\uC2A4\uD0D5\uC2A4\uC758
    \uBA64\uBC84\uC778 \uB108\uB97C \uAEBC\uB0B4\uC900 \uC774\uC720\uB2E4.\"\n\n\uC5D8\uB9AC\uC544\uC2A4:
    \"\uC815\uB9D0\uB85C \uC6B0\uB9AC\uAC00 \uACF5\uC874\uD560 \uC218 \uC788\uC744
    \uAC70\uB77C\uACE0 \uC0DD\uAC01\uD574?\"\n\n\uC870\uB825\uC790: \"\uAE00\uC384,
    \uD655\uC2E4\uD558\uAC8C \uB2F5\uD558\uC9C4 \uBABB\uD558\uACA0\uB2E4. \uADF8\uB7EC\uB098
    \uC2DC\uAC04\uC744 \uC8FC\uBA74 \uC6B0\uB9B0 \uBC14\uB014 \uAC83\uC774\uB2E4.
    \uB0B4\uAC00 \uADF8\uB807\uAC8C \uB9CC\uB4E4 \uAC70\uB2E4.\"\n\n\uC5D8\uB9AC\uC544\uC2A4:
    \"\uC54C\uC558\uC5B4. \uD589\uC6B4\uC744 \uBE4C\uC5B4.\"\n\n*\uC870\uB825\uC790\uAC00
    \uB5A0\uB09C\uB2E4*\n\n\uC5D8\uB9AC\uC544\uC2A4: \"\uACF5\uC874\uC774\uB77C...\"\n\n*\uC5D8\uB9AC\uC544\uC2A4\uB294
    \uAE4A\uC740 \uC0DD\uAC01\uC5D0 \uC7A0\uAE30\uBA70 \uB808\uC9C0\uC2A4\uD0D5\uC2A4
    \uBCF8\uBD80\uB85C \uB3CC\uC544\uAC04\uB2E4*\n\n\n\n\n<b><color=#FFFF00><size=200>End</size></color></b>"
  english: "<b><size=130><color=#EEEE00>RBT2024</color></size></b>\n\n\n\nDirector/Lead
    Programmer/All sorts of stuff: \uC7A5\uD604\uC6D0\n\nDesigner: \uD53C\uC740\uC11C\n\nProgrammer:
    \uC88C\uD638\uBE48, \uD669\uC0C1\uD604\n\n\n\n\n\n*A masked man approaches*\n\nEliath:
    \"Who's there?\"\n\n???: \"Before we say farewell, figured i had to tell you
    something.\"\n\nEliath: \"That voice...\"\n\nAssistant: \"Yep, It's me.\"\n\n*Assistant
    takes off their mask*\n\nEliath: \"You... You were a robot this whole time?\"\n\nAssistant:
    \"Yes.\"\n\nEliath: \"The Company must be your parent-like figure then... Why
    did you do this?\"\n\nAssistant: \"The Company's way of solving things is simply
    wrong. Controlling the humanity with robots won't bring anything but chaos.\"\n\nAssistant:
    \"I envision a future where both robots and humans live in harmony, Even if it
    means destroying The Company. That's why i brought you, a member of the resistance,
    out of that cell.\"\n\nEliath: \"Do you really think we can co-exist?\"\n\nAssistant:
    \"Well... I can't say for sure. But given some time, we'll change. I'll make
    sure it happens.\"\n\nEliath: \"Alright. Good luck.\"\n\n*Assistant leaves*\n\nEliath:
    \"Co-existing, huh...\"\n\n*Eliath returns to the resistance's base, deep in
    thought.*\n\n\n\n\n<b><color=#FFFF00><size=200>End</size></color></b>"
