  m_Name: 
  m_EditorClassIdentifier: 
  korean: "WASD \uC774\uB3D9\n\nLeftShift \uB2EC\uB9AC\uAE30\n\r\n\uC2A4\uD398\uC774\uC2A4\uBC14
    \uB300\uC2DC (\uB2EC\uB9AC\uB294 \uB3C4\uC911 \uC2AC\uB77C\uC774\uB4DC)\n\r\nTab\uD0A4
