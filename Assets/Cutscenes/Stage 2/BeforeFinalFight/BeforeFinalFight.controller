      en: Eliath
      kr: "\uC5D8\uB9AC\uC544\uC2A4"
    m_text:
      en: How many robots?
      kr: "\uB85C\uBD07\uC774 \uBA87 \uCC44 \uC788\uB294\uB370?"
    m_talkSound:
