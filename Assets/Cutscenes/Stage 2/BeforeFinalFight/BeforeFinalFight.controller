--- !u!114 &5257617593073186425
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 32df53259c366a246bac0937bf1cb740, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  segment:
    m_talker:
      en: Assistant
      kr: "\uC870\uB825\uC790"
    m_text:
      en: <color=#FF0000>At least 30.</color> Prepare yourself. <color=#FFFF00>Once
        you're ready, step in front of that door.</color> i'll open it for you.
      kr: "<color=#FF0000>\uC801\uC5B4\uB3C4 30\uCC44\uB294 \uB41C\uB2E4.</color>
        \uB9CC\uBC18\uC758 \uC900\uBE44\uB97C \uAC16\uCDB0\uB77C. <color=#FFFF00>\uC900\uBE44\uB410\uC73C\uBA74
        \uBB38 \uC55E\uC5D0 \uC11C\uB77C</color>, \uB0B4\uAC00 \uC5F4\uC5B4\uC904
        \uD14C\uB2C8."
    m_talkSound:
      clip: {fileID: 8300000, guid: d308f47766f0d5140877619784c405f9, type: 3}
      volume: 1
    m_skippable: 0
  progress: 1
