--- !u!114 &5847510319612770473
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 32df53259c366a246bac0937bf1cb740, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  segment:
    m_talker:
      en: Assistant
      kr: "\uC870\uB825\uC790"
    m_text:
      en: Cheer up, There's just one more thing to do. We have to delete their research
        data and your information. Go straight from here.
      kr: "\uD798 \uB0B4\uB9AC. \uC774\uC81C \uD558\uB098\uB9CC \uB354 \uD558\uBA74
        \uB41C\uB2E4. \uB188\uB4E4\uC758 \uC5F0\uAD6C \uAE30\uB85D\uC744 \uC9C0\uC6B0\uACE0,
        \uB124 \uC815\uBCF4\uB97C \uC81C\uAC70\uD558\uBA74 \uB41C\uB2E4. \uC5EC\uAE30\uC11C
        \uC55E\uC73C\uB85C \uCB49 \uAC00\uBA74 \uB41C\uB2E4."
    m_talkSound:
      clip: {fileID: 8300000, guid: d308f47766f0d5140877619784c405f9, type: 3}
      volume: 1
    m_skippable: 1
  progress: 1
