  m_Name: 
  m_EditorClassIdentifier: 
  segment:
    m_talker:
      en: Assistant
      kr: "\uC870\uB825\uC790"
    m_text:
      en: Let's first access their terminal inside. We need the access code.
      kr: "\uC77C\uB2E8 \uC5D1\uC138\uC2A4 \uCF54\uB4DC\uBD80\uD130 \uAD6C\uD574\uC57C
        \uD55C\uB2E4. \uC548\uCABD\uC5D0 \uC788\uB294 \uD130\uBBF8\uB110\uB85C \uAC00\uC790."
    m_talkSound:
      clip: {fileID: 8300000, guid: d308f47766f0d5140877619784c405f9, type: 3}
      volume: 1
    m_skippable: 1
  progress: 1
