--- !u!114 &55067865423124474
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 32df53259c366a246bac0937bf1cb740, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  segment:
    m_talker:
      en: Assistant
      kr: "\uC870\uB825\uC790"
    m_text:
      en: Yes. There's a destructive weapon The Company is working on. I want you
        to get rid of that research data.
      kr: "\uADF8\uB798. \uD68C\uC0AC\uAC00 \uB9CC\uB4E4\uACE0 \uC788\uB294 \uD55C
        \uAC15\uB825\uD55C \uBB34\uAE30\uAC00 \uD558\uB098 \uC788\uB2E4. \uB124\uAC00
        \uADF8 \uBB34\uAE30\uC758 \uC5F0\uAD6C \uC790\uB8CC\uB4E4\uC744 \uC5C6\uC560
        \uC92C\uC73C\uBA74 \uD55C\uB2E4."
    m_talkSound:
      clip: {fileID: 8300000, guid: d308f47766f0d5140877619784c405f9, type: 3}
      volume: 1
    m_skippable: 1
  progress: 1
