  m_EditorClassIdentifier: 
  segment:
    m_talker:
      en: Assistant
      kr: "\uC870\uB825\uC790"
    m_text:
      en: Alright. It's settled, then. Their research center isn't far from here.
        Head north.
      kr: "\uADF8\uB7FC \uACB0\uC815\uB410\uAD70. \uB188\uB4E4\uC758 \uC5F0\uAD6C\uC2E4\uC740
        \uC5EC\uAE30\uC11C \uBA40\uC9C0 \uC54A\uC544. \uBD81\uCABD\uC73C\uB85C \uAC00."
    m_talkSound:
      clip: {fileID: 8300000, guid: d308f47766f0d5140877619784c405f9, type: 3}
