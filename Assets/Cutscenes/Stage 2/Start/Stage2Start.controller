--- !u!114 &7066043539110169669
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 32df53259c366a246bac0937bf1cb740, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  segment:
    m_talker:
      en: Eliath
      kr: "\uC5D8\uB9AC\uC544\uC2A4"
    m_text:
      en: Well, i have to delete my information in their database, anyway.. I suppose
        i could do that, too.
      kr: "\uBB50, \uC5B4\uCC28\uD53C \uB188\uB4E4\uC758 \uB370\uC774\uD130\uBC30\uC774\uC2A4\uC5D0
        \uC788\uB294 \uB0B4 \uC815\uBCF4\uB3C4 \uC9C0\uC6CC\uC57C \uD588\uC73C\uB2C8..
        \uD558\uB294 \uAE40\uC5D0 \uADF8\uAC83\uB3C4 \uAC19\uC774 \uD560\uAC8C."
    m_talkSound:
      clip: {fileID: 8300000, guid: 3c11074dc65102442a30f09289ccc368, type: 3}
      volume: 1
    m_skippable: 1
  progress: 1
