  segment:
    m_talker:
      en: ???
      kr: ???
    m_text:
      en: You can call me 'Assistant' for now.
      kr: "\uC9C0\uAE08\uC740 \uC77C\uB2E8 '\uC870\uB825\uC790'\uB77C\uACE0 \uBD88\uB7EC\uB77C."
