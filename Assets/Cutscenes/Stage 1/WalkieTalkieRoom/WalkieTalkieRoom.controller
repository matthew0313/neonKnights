--- !u!114 &3061738466105336638
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 32df53259c366a246bac0937bf1cb740, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  segment:
    m_talker:
      en: Assistant
      kr: "\uC870\uB825\uC790"
    m_text:
      en: Qirks are special modifications applied to various gears.
      kr: "\uCFFC\uD06C\uB294 \uB2E4\uC591\uD55C \uC7A5\uBE44\uC5D0 \uBD99\uB294
        \uD2B9\uBCC4\uD55C \uAC1C\uC870\uC0AC\uD56D\uC774\uB2E4."
    m_talkSound:
      clip: {fileID: 8300000, guid: d308f47766f0d5140877619784c405f9, type: 3}
      volume: 1
    m_skippable: 1
  progress: 1
