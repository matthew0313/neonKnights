      en: That's none of your concern. Just know that i'll help your way out of there.
      kr: "\uADF8\uAC74 \uB124 \uC54C \uBC14\uAC00 \uC544\uB2C8\uB2E4. \uB0B4\uAC00
        \uB124 \uD0C8\uCD9C\uC744 \uB3C4\uC6B8 \uAC70\uB77C\uB294 \uAC83\uB9CC \uC54C\uC544\uB46C\uB77C."
    m_talkSound:
      clip: {fileID: 8300000, guid: d308f47766f0d5140877619784c405f9, type: 3}
      volume: 1
    m_skippable: 1
  progress: 1
