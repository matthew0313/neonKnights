    m_options:
    - en: What do you want?
      kr: "\uBAA9\uC801\uC774 \uBB50\uC9C0?"
    - en: Are you the one who opened the door?
      kr: "\uB2F9\uC2E0\uC774 \uBB38\uC744 \uC5F4\uC5B4\uC900 \uAC74\uAC00?"
