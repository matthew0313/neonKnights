  m_Name: 
  m_EditorClassIdentifier: 
  segment:
    m_talker:
      en: Assistant
      kr: "\uC870\uB825\uC790"
    m_text:
      en: Take those with you. Those equipments are a bit stronger than your usual
        ones.
      kr: "\uC774\uAC83\uB4E4\uC744 \uCC59\uACA8\uAC00\uB77C. \uD3C9\uC18C\uC5D0
        \uC0AC\uC6A9\uD558\uB294 \uC7A5\uBE44\uBCF4\uB2E4 \uC870\uAE08 \uB354 \uAC15\uB825\uD560
        \uAC70\uB2E4."
    m_talkSound:
      clip: {fileID: 8300000, guid: d308f47766f0d5140877619784c405f9, type: 3}
      volume: 1
    m_skippable: 1
  progress: 1
