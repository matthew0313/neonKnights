--- !u!114 &7302138662086207854
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 70060cff625b18a4ab32a206bab79625, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  segment:
    m_talker:
      en: Assistant
      kr: "\uC870\uB825\uC790"
    m_text:
      en: ..Unfortunetly, i can't tell you right now. Though, as for how i know this
        place so well, Let's just say i used to be a worker there.
      kr: "..\uC9C0\uAE08\uC740 \uC0AC\uC815\uC774 \uC788\uC5B4 \uB9D0\uD574\uC904
        \uC218 \uC5C6\uB2E4. \uD6C4\uC790\uC5D0 \uAD00\uD574\uC120, \uACFC\uAC70\uC5D0
        \uD55C \uBC88 \uC774\uACF3\uC758 \uC9C1\uC6D0\uC774\uC5C8\uB2E4\uACE0 \uD574\uB450\uC9C0."
    m_talkSound:
      clip: {fileID: 8300000, guid: d308f47766f0d5140877619784c405f9, type: 3}
      volume: 1
    m_skippable: 1
  choiceSegment:
    m_options:
    - en: When can i know?
      kr: "\uC5B8\uC81C\uCBE4 \uC54C \uC218 \uC788\uC9C0?"
    - en: ...Alright.
      kr: "...\uC54C\uC558\uC5B4."
