--- !u!114 &-3311122873100829909
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 32df53259c366a246bac0937bf1cb740, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  segment:
    m_talker:
      en: Assistant
      kr: "\uC870\uB825\uC790"
    m_text:
      en: Though it's abandoned, it's still sometimes used as a temporary cell to
        confine prisoners. Luckily, you ended up here, and i could get you out.
      kr: "\uBC84\uB824\uC84C\uAE34 \uD574\uB3C4 \uAC00\uB054\uC740 \uC77C\uC2DC\uC801\uC73C\uB85C
        \uC8C4\uC218\uB4E4\uC744 \uC218\uAC10\uD558\uB294 \uB370 \uC4F0\uC774\uACE4
        \uD55C\uB2E4. \uC6B4 \uC88B\uAC8C\uB3C4 \uB2C8\uAC00 \uC5EC\uAE30 \uC218\uAC10\uB410\uAE30\uC5D0
        \uB0B4\uAC00 \uD0C8\uCD9C\uC2DC\uCF1C \uC904 \uC218 \uC788\uB358 \uAC70\uACE0."
    m_talkSound:
      clip: {fileID: 8300000, guid: d308f47766f0d5140877619784c405f9, type: 3}
      volume: 1
    m_skippable: 1
  progress: 1
--- !u!114 &-3186664609802944481
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
