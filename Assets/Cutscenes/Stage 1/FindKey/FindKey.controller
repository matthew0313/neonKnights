  m_Name: 
  m_EditorClassIdentifier: 
  segment:
    m_talker:
      en: Eliath
      kr: "\uC5D8\uB9AC\uC544\uC2A4"
    m_text:
      en: Where am i?
      kr: "\uC5EC\uAE30\uB294 \uC5B4\uB514\uC57C?"
    m_talkSound:
      clip: {fileID: 8300000, guid: 3c11074dc65102442a30f09289ccc368, type: 3}
      volume: 1
    m_skippable: 1
  progress: 1
--- !u!114 &-2781225875524767265
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 32df53259c366a246bac0937bf1cb740, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  segment:
    m_talker:
      en: Assistant
      kr: "\uC870\uB825\uC790"
    m_text:
      en: This is where The Company often throws broken robots away. Some of them
        still function even to this day, though not in the best condition.
      kr: "\uC774\uACF3\uC740 \uD68C\uC0AC\uAC00 \uACE0\uC7A5\uB09C \uB85C\uBD07\uB4E4\uC744
        \uBC84\uB9AC\uB294 \uACF3\uC774\uAE30\uB3C4 \uD574. \uBA87\uBA87 \uB85C\uBD07\uB4E4\uC740
        \uBC84\uB824\uC9C4 \uC774\uD6C4\uC5D0\uB3C4 \uC9C0\uAE08\uAE4C\uC9C0 \uACC4\uC18D
        \uC791\uB3D9\uD558\uACE4 \uD558\uC9C0. \uC0C1\uD0DC\uB294 \uBB3C\uB860 \uCD5C\uC545\uC774\uC9C0\uB9CC."
    m_talkSound:
      clip: {fileID: 8300000, guid: d308f47766f0d5140877619784c405f9, type: 3}
      volume: 1
    m_skippable: 1
  progress: 1
