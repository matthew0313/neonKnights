--- !u!114 &-2184129945418548937
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 32df53259c366a246bac0937bf1cb740, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  segment:
    m_talker:
      en: Eliath
      kr: "\uC5D8\uB9AC\uC544\uC2A4"
    m_text:
      en: Who are you? How do you know this place so well?
      kr: "\uB2F9\uC2E0\uC740 \uB204\uAD6C\uC57C? \uC5B4\uB5BB\uAC8C \uC774\uACF3\uC5D0
        \uB300\uD574 \uADF8\uB807\uAC8C \uC798 \uC54C\uC9C0?"
    m_talkSound:
      clip: {fileID: 8300000, guid: 3c11074dc65102442a30f09289ccc368, type: 3}
      volume: 1
    m_skippable: 1
  progress: 1
--- !u!114 &-2057010507429169639
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 32df53259c366a246bac0937bf1cb740, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  segment:
    m_talker:
      en: Assistant
      kr: "\uC870\uB825\uC790"
    m_text:
      en: You're in an abandoned basement floor of The Company's building. It used
        to be a station, but abandoned long after The Company decided to take over
        the world.
      kr: "\uB10C \uC9C0\uAE08 \uD68C\uC0AC\uC758 \uBC84\uB824\uC9C4 \uC9C0\uD558\uC2E4\uC5D0
        \uC788\uB2E4. \uC608\uC804\uC5D0\uB294 \uC9C0\uD558\uCCA0 \uC815\uAC70\uC7A5\uC73C\uB85C
        \uC4F0\uC600\uB294\uB370, \uD68C\uC0AC\uAC00 \uC138\uC0C1\uC744 \uC810\uAC70\uD558\uAE30\uB85C
        \uD55C \uC774\uD6C4\uB85C \uBC84\uB824\uC9C0\uAC8C \uB418\uC5C8\uB2E4."
    m_talkSound:
      clip: {fileID: 8300000, guid: d308f47766f0d5140877619784c405f9, type: 3}
      volume: 1
    m_skippable: 1
  progress: 1
--- !u!114 &-1918230375901527106
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 32df53259c366a246bac0937bf1cb740, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  segment:
    m_talker:
      en: Eliath
      kr: "\uC5D8\uB9AC\uC544\uC2A4"
    m_text:
      en: Why are there robots here?
      kr: "\uC774\uACF3\uC5D0 \uC65C \uB85C\uBD07\uB4E4\uC774 \uC788\uC9C0?"
    m_talkSound:
      clip: {fileID: 8300000, guid: 3c11074dc65102442a30f09289ccc368, type: 3}
      volume: 1
    m_skippable: 1
  progress: 1
