  segment:
    m_talker:
      en: Assistant
      kr: "\uC870\uB825\uC790"
    m_text:
      en: Head left. There should be a key inside that room.
      kr: "\uC67C\uCABD\uC73C\uB85C \uAC00\uB77C. \uADF8 \uC548\uC5D0 \uC5F4\uC1E0\uAC00
