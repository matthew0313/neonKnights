--- !u!114 &-8190963508672620962
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 32df53259c366a246bac0937bf1cb740, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  segment:
    m_talker:
      en: Assistant
      kr: "\uC870\uB825\uC790"
    m_text:
      en: There are melee robots on the front row. Shielders will rush towards you
        with their shield. Aim for the weak point on their back after they rush.
        Watch out for slasher's attacks, they pack quite a punch.
      kr: "\uC55E\uCABD\uC5D0\uB294 \uADFC\uC811 \uB85C\uBD07\uB4E4\uC774 \uC788\uAD70.
        \uBC29\uD328\uBCD1\uB4E4\uC740 \uB110 \uBCF4\uBA74 \uB3CC\uC9C4\uD574 \uC62C
        \uAC70\uB2E4. \uB188\uB4E4\uC774 \uB3CC\uC9C4\uD55C \uB4A4\uC5D0 \uB4F1\uC5D0
        \uC788\uB294 \uC57D\uC810\uC744 \uB178\uB824. \uAC80 \uB85C\uBD07\uC758 \uACF5\uACA9\uC740
        \uAC15\uB825\uD558\uB2C8 \uC870\uC2EC\uD558\uACE0."
    m_talkSound:
      clip: {fileID: 8300000, guid: d308f47766f0d5140877619784c405f9, type: 3}
      volume: 1
    m_skippable: 1
  progress: 1
