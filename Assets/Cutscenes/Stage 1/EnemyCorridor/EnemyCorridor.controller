--- !u!114 &-2266019984286711308
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 32df53259c366a246bac0937bf1cb740, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  segment:
    m_talker:
      en: Assistant
      kr: "\uC870\uB825\uC790"
    m_text:
      en: Hold on.
      kr: "\uC7A0\uAE50\uB9CC."
    m_talkSound:
      clip: {fileID: 8300000, guid: d308f47766f0d5140877619784c405f9, type: 3}
      volume: 1
    m_skippable: 1
  progress: 1
--- !u!114 &-2262816110122534813
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 32df53259c366a246bac0937bf1cb740, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  segment:
    m_talker:
      en: Assistant
      kr: "\uC870\uB825\uC790"
    m_text:
      en: And there are ranged robots on the back row. These robots will shoot bullets
        at you. Fairly dodgable far away, but not up close. If you plan to use your
        knife, then aim for when they're reloading.
      kr: "\uADF8\uB9AC\uACE0 \uB4B7\uCABD\uC5D0\uB294 \uC6D0\uAC70\uB9AC \uB85C\uBD07\uB4E4\uC774
        \uC788\uB124. \uC598\uB124\uB4E4\uC740 \uB108\uB97C \uD5A5\uD574 \uCD1D\uC744
        \uC3E0 \uAC70\uC57C. \uBA40\uB9AC\uC11C\uB294 \uCDA9\uBD84\uD788 \uD53C\uD560
        \uB9CC \uD558\uC9C0\uB9CC \uAC00\uAE4C\uC774\uC5D0\uC120 \uC5B4\uB824\uC6CC.
        \uB098\uC774\uD504\uB97C \uC4F8 \uC0DD\uAC01\uC774\uB77C\uBA74 \uC7AC\uC7A5\uC804
        \uD560 \uB54C\uB97C \uB178\uB824."
    m_talkSound:
      clip: {fileID: 8300000, guid: d308f47766f0d5140877619784c405f9, type: 3}
      volume: 1
    m_skippable: 1
  progress: 1
